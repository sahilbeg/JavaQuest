<?xml version="1.0" encoding="UTF-8"?>
<!--
  Opens the practice folders as one project in your IDE, with JUnit available.
  The JavaQuest app also uses it to download the JUnit jars that it runs tests with.
  Each topic adds its src and test folders to the lists below. Solution folders are left out on purpose.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.javaquest</groupId>
  <artifactId>practice</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencies>
    <!-- One jar with the JUnit API, the engine and the console launcher, so the runner and the IDE share it. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-console-standalone</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- IDEs reuse this argLine, so money like %.2f prints with a point on every Mac, as in JavaQuest's checks. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <argLine>-Duser.language=en -Duser.country=US</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <execution>
            <id>topic-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>module-00-foundations/boss/src</source>
                <source>module-00-foundations/mini-project/src</source>
                <source>module-00-foundations/topic-05-hello-world/src</source>
                <source>module-01-basics/boss/src</source>
                <source>module-01-basics/mini-project/src</source>
                <source>module-01-basics/topic-01-variables/src</source>
                <source>module-01-basics/topic-02-primitive-types/src</source>
                <source>module-01-basics/topic-03-operators/src</source>
                <source>module-01-basics/topic-04-console-io/src</source>
                <source>module-01-basics/topic-05-if-else/src</source>
                <source>module-01-basics/topic-06-switch/src</source>
                <source>module-01-basics/topic-07-while-loops/src</source>
                <source>module-01-basics/topic-08-for-loops/src</source>
                <source>module-01-basics/topic-09-methods/src</source>
                <source>module-01-basics/topic-10-arrays/src</source>
                <source>module-01-basics/topic-11-strings/src</source>
                <source>module-01-basics/topic-12-stringbuilder-formatting/src</source>
                <source>module-02-oop/boss/src</source>
                <source>module-02-oop/mini-project/src</source>
                <source>module-02-oop/topic-01-classes-objects/src</source>
                <source>module-02-oop/topic-02-constructors/src</source>
                <source>module-02-oop/topic-03-encapsulation/src</source>
                <source>module-02-oop/topic-04-static-members/src</source>
                <source>module-02-oop/topic-05-inheritance/src</source>
                <source>module-02-oop/topic-06-polymorphism/src</source>
                <source>module-02-oop/topic-07-abstract-classes/src</source>
                <source>module-02-oop/topic-08-interfaces/src</source>
                <source>module-02-oop/topic-09-composition/src</source>
                <source>module-02-oop/topic-10-equals-hashcode-tostring/src</source>
                <source>module-02-oop/topic-11-records/src</source>
                <source>module-02-oop/topic-12-enums/src</source>
                <source>module-03-core-java/boss/src</source>
                <source>module-03-core-java/mini-project/src</source>
                <source>module-03-core-java/topic-01-collections-overview/src</source>
                <source>module-03-core-java/topic-02-lists/src</source>
                <source>module-03-core-java/topic-03-sets/src</source>
                <source>module-03-core-java/topic-04-maps/src</source>
                <source>module-03-core-java/topic-05-generics/src</source>
                <source>module-03-core-java/topic-06-comparators-iterators/src</source>
                <source>module-03-core-java/topic-07-exceptions/src</source>
                <source>module-03-core-java/topic-08-custom-exceptions/src</source>
                <source>module-03-core-java/topic-09-file-io/src</source>
                <source>module-03-core-java/topic-10-nio-files/src</source>
                <source>module-03-core-java/topic-11-date-time/src</source>
                <source>module-03-core-java/topic-12-lambdas/src</source>
                <source>module-03-core-java/topic-13-functional-interfaces/src</source>
                <source>module-03-core-java/topic-14-streams-basics/src</source>
                <source>module-03-core-java/topic-15-streams-advanced/src</source>
                <source>module-03-core-java/topic-16-optional/src</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>topic-tests</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>module-00-foundations/boss/test</source>
                <source>module-00-foundations/mini-project/test</source>
                <source>module-00-foundations/topic-05-hello-world/test</source>
                <source>module-01-basics/boss/test</source>
                <source>module-01-basics/mini-project/test</source>
                <source>module-01-basics/topic-01-variables/test</source>
                <source>module-01-basics/topic-02-primitive-types/test</source>
                <source>module-01-basics/topic-03-operators/test</source>
                <source>module-01-basics/topic-04-console-io/test</source>
                <source>module-01-basics/topic-05-if-else/test</source>
                <source>module-01-basics/topic-06-switch/test</source>
                <source>module-01-basics/topic-07-while-loops/test</source>
                <source>module-01-basics/topic-08-for-loops/test</source>
                <source>module-01-basics/topic-09-methods/test</source>
                <source>module-01-basics/topic-10-arrays/test</source>
                <source>module-01-basics/topic-11-strings/test</source>
                <source>module-01-basics/topic-12-stringbuilder-formatting/test</source>
                <source>module-02-oop/boss/test</source>
                <source>module-02-oop/mini-project/test</source>
                <source>module-02-oop/topic-01-classes-objects/test</source>
                <source>module-02-oop/topic-02-constructors/test</source>
                <source>module-02-oop/topic-03-encapsulation/test</source>
                <source>module-02-oop/topic-04-static-members/test</source>
                <source>module-02-oop/topic-05-inheritance/test</source>
                <source>module-02-oop/topic-06-polymorphism/test</source>
                <source>module-02-oop/topic-07-abstract-classes/test</source>
                <source>module-02-oop/topic-08-interfaces/test</source>
                <source>module-02-oop/topic-09-composition/test</source>
                <source>module-02-oop/topic-10-equals-hashcode-tostring/test</source>
                <source>module-02-oop/topic-11-records/test</source>
                <source>module-02-oop/topic-12-enums/test</source>
                <source>module-03-core-java/boss/test</source>
                <source>module-03-core-java/mini-project/test</source>
                <source>module-03-core-java/topic-01-collections-overview/test</source>
                <source>module-03-core-java/topic-02-lists/test</source>
                <source>module-03-core-java/topic-03-sets/test</source>
                <source>module-03-core-java/topic-04-maps/test</source>
                <source>module-03-core-java/topic-05-generics/test</source>
                <source>module-03-core-java/topic-06-comparators-iterators/test</source>
                <source>module-03-core-java/topic-07-exceptions/test</source>
                <source>module-03-core-java/topic-08-custom-exceptions/test</source>
                <source>module-03-core-java/topic-09-file-io/test</source>
                <source>module-03-core-java/topic-10-nio-files/test</source>
                <source>module-03-core-java/topic-11-date-time/test</source>
                <source>module-03-core-java/topic-12-lambdas/test</source>
                <source>module-03-core-java/topic-13-functional-interfaces/test</source>
                <source>module-03-core-java/topic-14-streams-basics/test</source>
                <source>module-03-core-java/topic-15-streams-advanced/test</source>
                <source>module-03-core-java/topic-16-optional/test</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
